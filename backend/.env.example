# ShubhDeep Backend Environment Configuration

# Database: Use Supabase PostgreSQL in production or SQLite for local dev
DATABASE_URL=sqlite:///./shubhdeep.db
# Example for Supabase:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# JWT Secret Key (Generate a random 32+ char key)
SECRET_KEY=shubhdeep-super-secret-key-change-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated, no trailing slashes)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://shubhdeep.pages.dev,https://your-site.vercel.app

# Initial Superadmin Setup (used only when admin table is empty)
INITIAL_ADMIN_EMAIL=admin@shubhdeep.in
INITIAL_ADMIN_PASSWORD=Admin@ShubhDeep2026

# Supabase Storage Configuration (Optional - for production product image uploads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=product-images
LOCAL_UPLOAD_DIR=uploads
